{
  "schemaVersion": 1,
  "presetName": "dotnet-react",
  "description": "C# .NET backend + React/Vite frontend. Standalone repo with one solution and one dashboard. Fits AstraGenie.MemoryService-style projects.",
  "projectType": "saas",
  "split": true,
  "frontend": { "framework": "react", "language": "typescript" },
  "backend": { "framework": "dotnet", "language": "csharp", "storage": "postgres" },
  "contract": "openapi",
  "deployment": "docker",
  "loop": {
    "aiLoopRoot": ".claude/artifacts/loop/ai-loop",
    "backlogPath": ".claude/artifacts/loop/ai-loop/backlog",
    "slicesRoot": ".claude/artifacts/loop/ai-loop/slices",
    "backlogRoot": ".claude/artifacts/loop/backlog",
    "specsRoot": ".claude/artifacts/loop/specs",
    "gradesRoot": ".claude/artifacts/loop/grades",
    "decisionsRoot": ".claude/artifacts/loop/decisions",
    "phaseGateArtifactDir": ".claude/artifacts/crew/validations",
    "marathonMode": true
  },
  "stack": {
    "build": [
      { "cmd": "dotnet", "args": ["build", "-c", "Release", "--nologo"] }
    ],
    "test": [
      { "cmd": "dotnet", "args": ["test", "-c", "Release", "--nologo"] }
    ],
    "frontendBuild": { "cmd": "npm", "args": ["run", "build"] },
    "infraPlan": null,
    "aspireBoot": null,
    "healthchecks": []
  },
  "reviewers": { "ladder": ["A", "B"] },
  "light": {
    "description": "FEAT-271: trimmed reviewer ladder for repos with a CI test gate -- single Reviewer A, behavior/test validation delegated to CI via loop.validation.satisfiedByReview. Applied by `/runner:install --light` on top of the base reviewers block above; do not enable on a repo with no CI test gate (keep the two-reviewer ladder there -- see ADOPTION.md).",
    "reviewers": { "ladder": ["A"] },
    "loop": { "validation": { "satisfiedByReview": true } }
  },
  "mandatoryDocs": [
    "docs/architecture/platform-overview.md"
  ],
  "productName": "Untitled product",
  "productDescription": "Override productName and productDescription in .claude/loop.json after install.",
  "stackDescription": "- C# .NET 10, ASP.NET Core, EF Core\n- React + Vite + TypeScript dashboard\n- xUnit for backend tests\n- pgvector / Postgres for storage when configured",
  "fe": {
    "skills": ["react-engineering", "typescript-pro", "frontend-advisory", "contract-codegen", "a11y-advisory"]
  },
  "be": {
    "skills": ["csharp-pro", "backend-advisory", "database-architecture", "contract-codegen"]
  },
  "roles": {
    "pm": {
      "skills": ["superpowers:verification-before-completion", "loop:loop-discipline"]
    },
    "researcher": {
      "skills": ["superpowers:verification-before-completion", "loop:loop-discipline"]
    },
    "architect": {
      "skills": ["loop:loop-discipline"]
    },
    "document-writer": {
      "skills": ["loop:loop-discipline"]
    }
  }
}
