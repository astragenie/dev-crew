{
  "name": "loop-plugin",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:tests": "tsc --project tsconfig.test.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "npm run build && npm run build:tests && node --test tests/*.test.mjs",
    "validate:manifests": "node ./scripts/validate-manifests.mjs",
    "validate:lengths": "node ./scripts/validate-content-length.mjs",
    "lint": "eslint src eslint.config.mjs",
    "format": "prettier --write \"src/**/*.mts\"",
    "format:check": "prettier --check \"src/**/*.mts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
