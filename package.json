{
  "name": "loop-plugin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:manifests": "node ./scripts/validate-manifests.mjs",
    "lint": "eslint scripts tests eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  }
}
