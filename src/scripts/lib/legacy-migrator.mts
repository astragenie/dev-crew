import fs from "node:fs/promises";
import path from "node:path";

import { pathExists } from "./paths.mjs";

// Migrates a consumer repo from the pre-v0.3.0 `autonomous-loop` identifier
// scheme to the new `loop` scheme. Runs at the very start of `installLoop`
// so subsequent install passes (marker block, rules write, etc.) operate on
// the already-renamed surface.
//
// Migrations performed:
//   1. .claude/autonomous-loop.json   -> .claude/loop.json
//   2. .claude/autonomous-loop/       -> .claude/loop/
//   3. CLAUDE.md HTML markers
//      <!-- autonomous-loop:start --> -> <!-- loop:start -->
//      <!-- autonomous-loop:end   --> -> <!-- loop:end   -->
//
// Each migration step is independent and idempotent:
//   - If the new path already exists, the legacy path is left alone (we do
//     NOT overwrite a present new file).
//   - If the legacy markers are absent, CLAUDE.md is left untouched.
//   - Running the migrator twice on the same repo is a no-op on the second
//     pass.

export const LEGACY_CONFIG_FILE = ".claude/autonomous-loop.json";
export const NEW_CONFIG_FILE = ".claude/loop.json";

export const LEGACY_RULES_DIR = ".claude/autonomous-loop";
export const NEW_RULES_DIR = ".claude/loop";

export const LEGACY_MARKER_START = "<!-- autonomous-loop:start -->";
export const LEGACY_MARKER_END = "<!-- autonomous-loop:end -->";
export const NEW_MARKER_START = "<!-- loop:start -->";
export const NEW_MARKER_END = "<!-- loop:end -->";

async function migrateConfigFile(repoPath, steps) {
  const legacyPath = path.join(repoPath, LEGACY_CONFIG_FILE);
  const newPath = path.join(repoPath, NEW_CONFIG_FILE);
  if (!(await pathExists(legacyPath))) {
    return;
  }
  if (await pathExists(newPath)) {
    steps.push({
      kind: "config",
      action: "skipped",
      from: LEGACY_CONFIG_FILE,
      to: NEW_CONFIG_FILE,
      reason: "destination already exists"
    });
    return;
  }
  await fs.mkdir(path.dirname(newPath), { recursive: true });
  await fs.rename(legacyPath, newPath);
  steps.push({
    kind: "config",
    action: "renamed",
    from: LEGACY_CONFIG_FILE,
    to: NEW_CONFIG_FILE
  });
}

async function migrateRulesDir(repoPath, steps) {
  const legacyDir = path.join(repoPath, LEGACY_RULES_DIR);
  const newDir = path.join(repoPath, NEW_RULES_DIR);
  if (!(await pathExists(legacyDir))) {
    return;
  }
  if (await pathExists(newDir)) {
    steps.push({
      kind: "rules-dir",
      action: "skipped",
      from: LEGACY_RULES_DIR,
      to: NEW_RULES_DIR,
      reason: "destination already exists"
    });
    return;
  }
  await fs.rename(legacyDir, newDir);
  steps.push({
    kind: "rules-dir",
    action: "renamed",
    from: LEGACY_RULES_DIR,
    to: NEW_RULES_DIR
  });
}

// Rewrites HTML marker comments inside the CLAUDE.md block AND any other
// occurrences of `autonomous-loop` inside the block that reference the new
// config path (`.claude/autonomous-loop.json`) or rules dir
// (`.claude/autonomous-loop/`). The block itself is then regenerated by the
// installer's normal marker-block-replace pass.
async function migrateClaudeMdMarkers(repoPath, steps) {
  const claudePath = path.join(repoPath, "CLAUDE.md");
  let content;
  try {
    content = await fs.readFile(claudePath, "utf8");
  } catch (error) {
    if (error.code === "ENOENT") {
      return;
    }
    throw error;
  }
  if (!content.includes(LEGACY_MARKER_START) && !content.includes(LEGACY_MARKER_END)) {
    return;
  }
  const next = content
    .split(LEGACY_MARKER_START)
    .join(NEW_MARKER_START)
    .split(LEGACY_MARKER_END)
    .join(NEW_MARKER_END);
  if (next === content) {
    return;
  }
  await fs.writeFile(claudePath, next);
  steps.push({
    kind: "claude-md-markers",
    action: "rewritten",
    file: "CLAUDE.md"
  });
}

// Run all legacy migrations against `repoPath`. Returns:
//   { migrated: boolean, steps: Array<{kind, action, ...}> }
// `migrated` is true iff at least one step performed a write (action !=
// "skipped"). The installer logs the steps and includes them in its result.
export async function migrateLegacyAutonomousLoop(repoPath) {
  const steps: any[] = [];
  await migrateConfigFile(repoPath, steps);
  await migrateRulesDir(repoPath, steps);
  await migrateClaudeMdMarkers(repoPath, steps);
  const migrated = steps.some((s) => s.action !== "skipped");
  return { migrated, steps };
}
