{
  "preset": "typescript-plugin-dev",
  "schemaVersion": 1,
  "memory": {
    "enabled": true,
    "project": "runner-plugin",
    "profile": {
      "enabled": true,
      "topLessons": 10,
      "timeoutMs": 20000
    },
    "feedback": {
      "enabled": true,
      "timeoutMs": 20000,
      "creditLoop": {
        "enabled": true,
        "k": 5
      }
    }
  },
  "projectType": "claude-plugin",
  "split": false,
  "frontend": {
    "framework": "none",
    "language": "typescript"
  },
  "backend": {
    "framework": "node",
    "language": "typescript",
    "storage": "none"
  },
  "contract": "none",
  "deployment": "none",
  "skills": [
    "typescript-pro",
    "frontend-advisory"
  ],
  "features": {
    "redundant-read-stop": {
      "enabled": false
    }
  },
  "loop": {
    "notifications": {
      "_comment": "Pattern B: bearer resolved at runtime from ~/.astrarunner/tokens.json via appId lookup. Repo config carries identifiers only — never commit a bearer. Filesystem-resync watcher (separate code path) is the durable fallback when LOOP_INGEST_URL+TOKEN env set.",
      "enabled": true,
      "mode": "webhook",
      "events": [
        "slice-start",
        "slice-complete",
        "halt-badge",
        "cost-alert"
      ],
      "webhook": {
        "url": "https://api.astrarunner.com/api/v2/ingest/loop-events",
        "tenantId": "4891d621-2ed9-4004-8cf8-708a45934588",
        "appId": "2d5f07b9-335e-42e6-a25d-c8cce12e8f43"
      }
    },
    "aiLoopRoot": ".claude/artifacts/loop/ai-loop",
    "backlogPath": ".claude/artifacts/loop/ai-loop/backlog",
    "slicesRoot": ".claude/artifacts/loop/ai-loop/slices",
    "backlogRoot": ".claude/artifacts/loop/backlog",
    "specsRoot": ".claude/artifacts/loop/specs",
    "gradesRoot": ".claude/artifacts/loop/grades",
    "decisionsRoot": ".claude/artifacts/loop/decisions",
    "phaseGateArtifactDir": ".claude/artifacts/crew/validations",
    "maxIterations": 25,
    "marathonMode": true,
    "autoMode": true,
    "redundantReadCap": 10,
    "orchestratorModel": "sonnet",
    "dispatchLimits": {
      "maxSubagentsPerSlice": 4,
      "expandedInlineCriteria": true,
      "preferInlineFor": [
        "single-file-edit",
        "test-fix",
        "lint-fix",
        "format-fix",
        "doc-update",
        "config-tweak",
        "single-module-edit",
        "test-only"
      ]
    },
    "modelRouting": {
      "enabled": false,
      "default": "sonnet",
      "sliceStart": "opus",
      "architect": "opus",
      "review": "sonnet",
      "decompose": "sonnet",
      "gradeWrite": "sonnet",
      "build": "sonnet",
      "validate": "sonnet",
      "copywriter": "sonnet",
      "docwriter": "sonnet"
    },
    "triageBudgetUsdPerBatch": 5,
    "triageBudgetTokensPerBatch": 500000,
    "intakeBudgetUsdPerCall": 1.5,
    "intakeBudgetTokensPerCall": 150000,
    "gradeTrendPerDimension": {
      "observability": 0.7
    },
    "marathonRunner": "wave",
    "wave": {
      "size": 3,
      "sliceCommand": "/crew:orchestrate-slice",
      "sliceCommandFallback": "/crew:build",
      "fixCommand": "/crew:fix",
      "maxParallel": 3,
      "dispatchTimeoutMs": 1800000,
      "postMergeTestCmd": "bun test src/tests/ --parallel --timeout 60000",
      "maxWaveAttempts": 2,
      "subagentType": "general-purpose",
      "artifactsRoot": ".claude/artifacts/loop/waves"
    },
    "marathonCheckpointEvery": 4,
    "validation": {
      "satisfiedByReview": true
    },
    "perfBaseline": {
      "medianWallClockSeconds": 1200,
      "avgGrade": 0.835,
      "pinnedAt": "2026-06-11"
    },
    "cost": {
      "ceilingUsd": 200,
      "regression": {
        "multiplier": 6,
        "window": 5,
        "minSamples": 3,
        "project": "C--work-mega-loop",
        "projectAliases": [
          "C--work-mega-hero-crew-autonomous-loop"
        ]
      }
    },
    "warnAlertCategoriesIgnoredInAutoMode": [
      "score-trend",
      "decomposition"
    ]
  },
  "stack": {
    "build": [
      {
        "cmd": "npm",
        "args": [
          "run",
          "lint"
        ]
      }
    ],
    "test": [
      {
        "cmd": "npm",
        "args": [
          "test"
        ]
      }
    ],
    "frontendBuild": null,
    "infraPlan": null,
    "aspireBoot": null,
    "healthchecks": []
  },
  "reviewers": {
    "ladder": [
      "A"
    ],
    "strictParallel": true,
    "serialTimingThresholdMs": 90000
  },
  "slice": {
    "postBuilderFanout": true
  },
  "phaseGate": {
    "parallel": true,
    "groups": {
      "lint": [
        {
          "cmd": "bun",
          "args": [
            "run",
            "lint"
          ]
        },
        {
          "cmd": "bun",
          "args": [
            "run",
            "format:check"
          ]
        },
        {
          "cmd": "bun",
          "args": [
            "./src/scripts/validate-manifests.mts"
          ]
        },
        {
          "cmd": "bun",
          "args": [
            "./src/scripts/validate-content-length.mts"
          ]
        }
      ],
      "typecheck": [
        {
          "cmd": "bunx",
          "args": [
            "tsc",
            "--project",
            "tsconfig.json",
            "--noEmit"
          ]
        },
        {
          "cmd": "bunx",
          "args": [
            "tsc",
            "--project",
            "tsconfig.test.json",
            "--noEmit"
          ]
        }
      ],
      "test": [
        {
          "cmd": "bun",
          "args": [
            "test",
            "src/tests/",
            "--parallel",
            "--timeout",
            "60000"
          ]
        }
      ]
    }
  },
  "mandatoryDocs": [
    "docs/architecture/platform-overview.md"
  ],
  "productName": "runner",
  "productDescription": "Claude Code plugin: Wiggin-Loop methodology layer for autonomous slice-based development on top of the crew plugin.",
  "stackDescription": "- ESM Node.js (.mjs modules)\n- node --test for testing\n- ESLint + Prettier for linting/formatting",
  "github": {
    "enabled": true,
    "repo": null
  }
}
