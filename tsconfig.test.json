{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["node", "bun-types"]
  },
  "include": [
    "src/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".claude",
    "docs",
    "dist"
  ]
}