{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".",
    "rootDir": "src",
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".claude",
    "docs",
    "dist"
  ]
}